# csvx backend as a systemd service.
#
# Install:
#   sudo cp deploy/csvx.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now csvx
#
# The binary is expected at /usr/local/bin/csvx and the served directory at
# /srv/csvx. Point --root at your own data; nothing else is required.
#
# Bound to loopback on purpose: this build has no authentication and is single-user.
# To reach it from another machine, put it behind a reverse proxy that authenticates,
# do not bind 0.0.0.0 directly.

[Unit]
Description=csvx backend
Documentation=https://github.com/Li-Binzhuang/csv-splitter/blob/main/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=csvx
Group=csvx
WorkingDirectory=/srv/csvx
ExecStartPre=/usr/local/bin/csvx serve --check --root /srv/csvx --port 8787
ExecStart=/usr/local/bin/csvx serve --root /srv/csvx --port 8787
Restart=on-failure
RestartSec=2

# Graceful stop: SIGTERM stops accepting, lets in-flight requests finish and gives
# running jobs up to five seconds before the process exits 0.
KillSignal=SIGTERM
TimeoutStopSec=15

# The process only reads the served directory and writes sidecars next to the files
# it serves (.idx, .parquet, .journal). It never rewrites the CSV itself.
ReadWritePaths=/srv/csvx

# Hardening that does not get in the way.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
